# Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Supabase Credentials (Optional for Phase 2 public scale; Local mock store runs out-of-the-box)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public Application Domain URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud project NUMBER that owns the Meet add-on deployment.
# Meet rejects the add-on session with InvalidCloudProjectNumber without it.
NEXT_PUBLIC_MEET_CLOUD_PROJECT_NUMBER="740104195038"
